<?xml version="1.0" encoding="utf-8"?>
<!-- Mirrors the proven manual build's manifest (plain Activity + WebView,
     no AppCompat): package com.youcandoit2221.game, minSdk 24, targetSdk 36,
     INTERNET only, framework Theme.Material.NoActionBar. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    android:versionCode="28"
    android:versionName="3.7">

    <uses-sdk android:minSdkVersion="24" android:targetSdkVersion="36" />
    <uses-permission android:name="android.permission.INTERNET" />

    <application
        android:label="Match-3 Earn"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round">

        <!-- AdMob application ID. ${admobAppId} comes from the manifest
             placeholder in app/build.gradle: Google's TEST app ID by
             default, the real ID via -PadmobAppId or the ADMOB_APP_ID
             repo secret. The app must not ship without a valid ID here. -->
        <meta-data
            android:name="com.google.android.gms.ads.APPLICATION_ID"
            android:value="${admobAppId}" />

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:theme="@android:style/Theme.Material.NoActionBar"
            android:configChanges="orientation|screenSize|keyboardHidden">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
